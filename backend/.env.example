# ── Nails Studio backend · PLANTILLA SIN SECRETOS ──
# Copiar a .env y rellenar. Nunca commitear el .env real.
APP_NAME=nails-studio
ENV=local
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SECRET_KEY=cambia-esta-clave-minimo-32-caracteres
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=
FRONTEND_ORIGIN=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173
SMTP_USER=
SMTP_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
# Gmail: SMTP_USER=tu@gmail.com + App Password de 16 letras
# (Cuenta Google con 2FA → myaccount.google.com/apppasswords).
ADMIN_EMAIL=admin@nailsstudio.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-en-primer-arranque-min-12-caracteres
